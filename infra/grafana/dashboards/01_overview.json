{
  "uid": "attt-overview",
  "title": "ATTT — System Overview",
  "tags": ["attt"],
  "schemaVersion": 38,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total Scans",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(attt_scan_total)", "legendFormat": "Total"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2, "type": "stat", "title": "Active Scans",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "attt_active_scans", "legendFormat": "Active"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 5}, {"color": "red", "value": 20}]}
      }
    },
    {
      "id": 3, "type": "stat", "title": "Scans Completed (1h)",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "increase(attt_scan_total{status='complete'}[1h])", "legendFormat": "Completed"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4, "type": "stat", "title": "Scans Failed (1h)",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "increase(attt_scan_total{status='failed'}[1h])", "legendFormat": "Failed"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}
      }
    },
    {
      "id": 5, "type": "stat", "title": "Auth Failures (1h)",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "increase(attt_auth_failures_total[1h])", "legendFormat": "Auth Failures"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 10}, {"color": "red", "value": 50}]}
      }
    },
    {
      "id": 6, "type": "stat", "title": "Rate Limit Hits (1h)",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "increase(attt_rate_limit_hits_total[1h])", "legendFormat": "Rate Limited"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 10, "type": "timeseries", "title": "Scan Rate (per 5m)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(attt_scan_total{status='complete'}[5m])*300", "legendFormat": "Completed"},
        {"expr": "rate(attt_scan_total{status='failed'}[5m])*300", "legendFormat": "Failed"},
        {"expr": "rate(attt_scan_total{status='queued'}[5m])*300", "legendFormat": "Queued"}
      ]
    },
    {
      "id": 11, "type": "timeseries", "title": "Findings by Severity (per 5m)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(attt_scan_findings_total{severity='critical'}[5m])*300", "legendFormat": "Critical"},
        {"expr": "rate(attt_scan_findings_total{severity='high'}[5m])*300", "legendFormat": "High"},
        {"expr": "rate(attt_scan_findings_total{severity='medium'}[5m])*300", "legendFormat": "Medium"},
        {"expr": "rate(attt_scan_findings_total{severity='low'}[5m])*300", "legendFormat": "Low"}
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "HTTP Request Rate (per 5m)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(http_requests_total[5m])*300", "legendFormat": "{{method}} {{handler}}"}
      ]
    },
    {
      "id": 13, "type": "timeseries", "title": "HTTP p95 Latency",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "p95"}
      ]
    }
  ]
}
