{
  "uid": "attt-rag",
  "title": "ATTT — RAG & Knowledge Base",
  "tags": ["attt", "rag"],
  "schemaVersion": 38,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "RAG Queries (1h)",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "increase(attt_rag_retrieval_latency_seconds_count[1h])", "legendFormat": "Queries"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2, "type": "stat", "title": "Avg Retrieval Latency",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [{
        "expr": "rate(attt_rag_retrieval_latency_seconds_sum[5m]) / rate(attt_rag_retrieval_latency_seconds_count[5m])",
        "legendFormat": "Avg Latency"
      }],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "unit": "s"}
    },
    {
      "id": 3, "type": "stat", "title": "Avg Chunks Returned",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [{
        "expr": "rate(attt_rag_chunks_returned_sum[5m]) / rate(attt_rag_chunks_returned_count[5m])",
        "legendFormat": "Avg Chunks"
      }],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 10, "type": "timeseries", "title": "RAG Retrieval Latency (p50 / p95 / p99)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(attt_rag_retrieval_latency_seconds_bucket[5m]))", "legendFormat": "p99"},
        {"expr": "histogram_quantile(0.95, rate(attt_rag_retrieval_latency_seconds_bucket[5m]))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.50, rate(attt_rag_retrieval_latency_seconds_bucket[5m]))", "legendFormat": "p50"}
      ]
    },
    {
      "id": 11, "type": "timeseries", "title": "RAG Query Rate (per 5m)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(attt_rag_retrieval_latency_seconds_count[5m])*300", "legendFormat": "Queries"}
      ]
    },
    {
      "id": 12, "type": "heatmap", "title": "Chunks Returned Distribution",
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8},
      "targets": [
        {"expr": "rate(attt_rag_chunks_returned_bucket[5m])", "legendFormat": "{{le}}"}
      ],
      "options": {"calculate": false, "yAxis": {"unit": "short"}}
    }
  ]
}
